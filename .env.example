# Copy to .env for local development. Use 5433 if 5432 is already occupied.
POSTGRES_PORT=5433
POSTGRES_DB=anchor
POSTGRES_USER=anchor
POSTGRES_PASSWORD=anchor-local-dev
# Used by npm run dev / npm start. Compose supplies its own internal PGHOST.
DATABASE_URL=postgresql://anchor:anchor-local-dev@127.0.0.1:5433/anchor
# Explicit local-only prototype opt-in; this is NOT authentication.
ENABLE_TEMPLATE_AUTHORING=true
# Passwordless local hackathon account selection, NOT real authentication.
ENABLE_DEMO_LOGIN=true
# Set true behind HTTPS; false is required for plain HTTP localhost.
# dev:https and docker-compose.https.yml force true without editing this value.
SESSION_COOKIE_SECURE=false
# Plain-HTTP Docker app bind address (port 3000). Loopback by default; set to
# 0.0.0.0 (or the server's private LAN IP) to let teammates reach it over HTTP.
# The HTTPS overlay removes this port entirely.
# ANCHOR_HTTP_BIND=127.0.0.1

# Optional HTTPS settings. Defaults are loopback-only; for teammates use the
# server's private LAN IP covered by the certificate (never a public interface).
# ANCHOR_HTTPS_BIND=127.0.0.1
# ANCHOR_HTTPS_PORT=3443
# dev:https certificate paths (relative to the repo; Compose uses the defaults).
# ANCHOR_HTTPS_CERT=certificates/anchor.pem
# ANCHOR_HTTPS_KEY=certificates/anchor-key.pem

# API Key for AI assisted features.
# OPENAI_KEY=