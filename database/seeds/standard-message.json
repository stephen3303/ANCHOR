{
  "name": "Standard Message",
  "description": "Template for a typical message",
  "text": "{{ Precedence }} {{ DateTime }}\nFM {{ Origin }}\nTO {{ Recipients }}\nINFO {{ Info }}\nBT\n{{ Classification }}//\nMSGID/{{ Type }}/{{ Origin }}//\nSUBJ/{{ Subject }}//\nPOC/{{ POC }}//\nRMKS/{{ Body }}//\nBT\n{{ Message Number }}\nNNNN",
  "fields": [
    {
      "name": "Precedence",
      "control": "select",
      "required": true,
      "options": ["R - Routine", "P - Priority", "O - Immediate", "Z - Flash"],
      "optionOutputs": {
        "R - Routine": "R",
        "P - Priority": "P",
        "O - Immediate": "O",
        "Z - Flash": "Z"
      }
    },
    { "name": "DateTime", "control": "text", "required": true, "options": [] },
    {
      "name": "Origin",
      "control": "autogenerated",
      "required": true,
      "options": [],
      "generator": { "key": "sending-command", "version": 1 }
    },
    {
      "name": "Recipients",
      "control": "command-multiple",
      "required": true,
      "options": [],
      "separator": "newline"
    },
    {
      "name": "Info",
      "control": "command-multiple",
      "required": true,
      "options": [],
      "separator": "newline"
    },
    { "name": "Classification", "control": "text", "required": true, "options": [] },
    { "name": "Type", "control": "text", "required": true, "options": [] },
    { "name": "Subject", "control": "text", "required": true, "options": [] },
    { "name": "POC", "control": "text", "required": true, "options": [] },
    { "name": "Body", "control": "textarea", "required": true, "options": [] },
    { "name": "Message Number", "control": "text", "required": true, "options": [] }
  ]
}
