{
  "name": "Standard Message",
  "description": "Template for a typical message",
  "text": "TODO: figure out header\n{{ Precedence }} {{ Message DateTime }}\nFM {{ Origin Command }}\nTO {{ Recipient Commands }}\nINFO {{ Info Commands }}\nBT\n{{ Classification }}//\nMSGID/{{ Msg Type }}/{{ Origin Command }}//\nSUBJ/{{ Subject }}//\nPOC/{{ Point of Contact }}//\nRMKS/{{ Body }}//\nBT\n{{ Message Number }}\nNNNN",
  "fields": [
    {
      "name": "Precedence",
      "control": "select",
      "required": true,
      "options": ["R - Routine", "P - Priority", "O - Immediate", "Z - Flash"],
      "optionOutputs": {
        "R - Routine": "R",
        "P - Priority": "P",
        "O - Immediate": "O",
        "Z - Flash": "Z"
      }
    },
    { "name": "Message DateTime", "control": "text", "required": true, "options": [] },
    {
      "name": "Origin Command",
      "control": "autogenerated",
      "required": true,
      "options": [],
      "generator": { "key": "sending-command", "version": 1 }
    },
    {
      "name": "Recipient Commands",
      "control": "command-multiple",
      "required": true,
      "options": [],
      "separator": "newline"
    },
    {
      "name": "Info Commands",
      "control": "command-multiple",
      "required": true,
      "options": [],
      "separator": "newline"
    },
    { "name": "Classification", "control": "text", "required": true, "options": [] },
    { "name": "Msg Type", "control": "text", "required": true, "options": [] },
    { "name": "Subject", "control": "text", "required": true, "options": [] },
    { "name": "Point of Contact", "control": "text", "required": true, "options": [] },
    { "name": "Body", "control": "text", "required": true, "options": [] },
    { "name": "Message Number", "control": "text", "required": true, "options": [] }
  ]
}
