{
  "name": "anchor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "app:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update.ps1",
    "db:seed:commands": "node scripts/seed-commands.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:seed:users": "tsx scripts/seed-users.ts",
    "db:seed:routing": "tsx scripts/seed-routing.ts",
    "db:seed:templates": "tsx scripts/seed-templates.ts",
    "db:seed:messages": "tsx scripts/seed-messages.ts",
    "test:templates": "tsx --test src/lib/message-templates.test.ts src/lib/template-topics.test.ts src/lib/message-inputs.test.ts src/lib/message-format.test.ts src/lib/command-search.test.ts",
    "test:columns": "tsx --test src/lib/message-columns.test.ts",
    "test:templates:api": "node scripts/test-template-api.mjs",
    "test:templates:browser": "node scripts/test-template-api.mjs --browser",
    "test:messages": "tsx --test src/lib/naval.test.ts",
    "test:messages:api": "node scripts/test-message-api.mjs",
    "test:drafting:api": "node scripts/test-drafting-api.mjs",
    "test:drafting:browser": "node scripts/test-drafting-api.mjs --browser",
    "test:templates:seed": "tsx scripts/test-template-seed.ts",
    "test:navigation": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
